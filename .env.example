# Supabase (region สิงคโปร์) — ใช้ dev project เท่านั้นตอนพัฒนา
# runtime: transaction pooler
DATABASE_URL="postgres://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"
# prisma migrate: direct connection
DIRECT_URL="postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# LINE Login (ดู docs/line.md) ไม่ตั้ง = หน้า /remind แสดง "เร็วๆ นี้"
AUTH_SECRET=""
AUTH_LINE_ID=""
AUTH_LINE_SECRET=""
AUTH_TRUST_HOST=true
